{
  "manifest_version": 3,
  "name": "Dot Pet Dock",
  "version": "0.1.0",
  "description": "Give your ChatGPT Dot pet a draggable, resizable display on the web.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Dot Pet Dock",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
